                stop
              else (yes)
                :Гипотеза 2 отклонена;
              endif
            endif
          else (yes)
            :Гипотеза 2 отклонена;
          endif
        else (no)
          :Гипотеза 2 отклонена;
        endif
      else (no)
        :Гипотеза 2 отклонена;
      endif
    else (no)
