@startuml
title Дерево принятия решений dog_expert.clp (CLIPS): каждый ромб — правило опроса, стрелка — ответ yes/no

skinparam defaultTextAlignment center
skinparam shadowing false

legend left
  Ромб = правило determine-* (вопрос пользователю), подпись стрелки = ответ yes (y) / no (n).
  Ответ сохраняется фактом (symptom <id> yes|no), поэтому повторно вопрос не задаётся.
  Вывод синдромов/факторов/признаков (salience 350) и диагнозов (320..301) выполняется немедленно.
  При срабатывании диагноза условие (not (diagnosis ?)) мгновенно останавливает дальнейший опрос.
  Красный — экстренно (AAHA), жёлтый — срочно / в день обращения, зелёный — планово.
endlegend

start
:Запуск: (reset) -> загрузка clinical-recommendations -> (run)\nВывод system-banner (salience 500);

partition "1. Острое расширение и заворот желудка — GDV (salience 200..197 -> 320)" {
  if (Рвота или безуспешные позывы к рвоте?) then (yes)
    if (Позывы к рвоте носят непродуктивный характер?) then (yes)
      if (Быстрое вздутие и напряжение живота?) then (yes)
        if (Обильное слюнотечение и беспокойство?) then (yes)
          #FFCDD2:1. Острое расширение и заворот желудка (GDV);
          stop
        else (no)
          :Гипотеза 1 отклонена;
        endif
      else (no)
        :Гипотеза 1 отклонена;
      endif
    else (no)
      :Гипотеза 1 отклонена;
    endif
  else (no)
    :Гипотеза 1 отклонена;
  endif
}

partition "2. Парвовирусный энтерит (salience 195..190 -> 319)" {
  if (Рвота или безуспешные позывы к рвоте?) then (yes)
