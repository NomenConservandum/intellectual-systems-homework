;;;********************************************************************
;;;  Раздел 3, задание 1. Шаблон неупорядоченного факта client
;;;  Слот citi имеет значение по умолчанию Moskva
;;;********************************************************************

(deftemplate client "Данные о клиенте"
   (slot name)
   (slot in)
   (slot citi (default Moskva)))

