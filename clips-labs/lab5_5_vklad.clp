;;;********************************************************************
;;;  Раздел 5, задание 5. Процедурные функции
;;;
;;;  Условие:
;;;    Первоначальная сумма вклада в банк составляет S0 руб.,
;;;    процентная ставка — p% годовых. Через сколько лет сумма вклада
;;;    более чем в 2 раза превысит первоначальную?
;;;
;;;  Запуск в CLIPS:
;;;    (clear)
;;;    (load "clips-labs/lab5_5_vklad.clp")
;;;    (reset)
;;;    (run)
;;;********************************************************************

(defrule vklad_udvoenie "Определение числа лет для превышения вклада более чем в 2 раза"
   =>
   (printout t "Введите первоначальную сумму вклада S0 (руб.): ")
   (bind ?s0 (read))
   (while (or (not (numberp ?s0)) (<= ?s0 0)) do
      (printout t "Ошибка: введите положительное число S0: ")
      (bind ?s0 (read)))
   (printout t "Введите годовую процентную ставку p (%): ")
   (bind ?p (read))
   (while (or (not (numberp ?p)) (<= ?p 0)) do
      (printout t "Ошибка: введите положительную ставку p: ")
      (bind ?p (read)))
   (bind ?s ?s0)
   (bind ?years 0)
   (bind ?target (* 2 ?s0))
   (while (<= ?s ?target) do
      (bind ?s (* ?s (+ 1 (/ ?p 100))))
      (bind ?years (+ ?years 1)))
   (printout t "Сумма вклада превысит удвоенную первоначальную через " ?years " лет." crlf)
   (printout t "Итоговая сумма: " ?s " руб." crlf))

