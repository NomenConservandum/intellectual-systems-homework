;;;********************************************************************
;;;  Раздел 2, задание 2. Упорядоченные факты (poezd)
;;;
;;;  Условие:
;;;    Создать 3 упорядоченных факта вида
;;;      (poezd <номер> <пункт_назначения> <время_отправления>)
;;;    с помощью deffacts. Добавить 2 новых факта через assert.
;;;    Просмотреть список фактов. Удалить факты с индексами 1 и 4.
;;;    В фактах с индексами 2 и 3 изменить время отправления.
;;;
;;;  Запуск: clips -f2 clips-labs/lab2_2_poezd.clp
;;;********************************************************************

(clear)

;;; 1. Создание 3 упорядоченных фактов через deffacts
(deffacts poezda
   (poezd 101 Moskva 08:30)
   (poezd 202 Kazan 12:15)
   (poezd 303 Samara 16:45))

(reset)

;;; 2. Добавление 2 новых фактов через assert
(assert (poezd 404 Sochi 19:00)
        (poezd 505 Perm 22:10))

;;; 3. Просмотр полученного списка фактов (f-1 .. f-5)
(printout t "--- Исходный список фактов (5 поездов) ---" crlf)
(facts)

;;; 4. Удаление фактов с индексами 1 и 4
(retract 1 4)
(printout t "--- После удаления f-1 и f-4 ---" crlf)
(facts)

;;; 5. Изменение времени отправления в фактах f-2 и f-3
;;;    (для упорядоченных фактов: удаление старого и добавление нового)
(retract 2)
(assert (poezd 202 Kazan 13:00))

(retract 3)
(assert (poezd 303 Samara 17:30))

(printout t "--- Итоговый список фактов после изменения f-2 и f-3 ---" crlf)
(facts)
(exit)

