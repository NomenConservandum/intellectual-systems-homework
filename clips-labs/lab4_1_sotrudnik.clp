;;;********************************************************************
;;;  Раздел 4, задание 1. Правила и условные элементы (test, forall, exists)
;;;
;;;  Условие:
;;;    С помощью deffacts создать список из 5 упорядоченных фактов вида:
;;;      (sotrudnik <фамилия> <стаж_работы> <кол-во_детей> <оклад>)
;;;    Определить правила:
;;;      1) Начисления премии (20% от оклада) сотрудникам со стажем >= 5 лет
;;;         или с количеством детей > 2: факт (premia <фамилия> <сумма>).
;;;      2) Определяющее, все ли сотрудники получили премию (вывод сообщения).
;;;      3) Определяющее, есть ли среди сотрудников ветераны труда
;;;         (стаж > 20 лет) (вывод сообщения).
;;;
;;;  Запуск в CLIPS:
;;;    (clear)
;;;    (load "clips-labs/lab4_1_sotrudnik.clp")
;;;    (reset)
;;;    (run)
;;;    (facts)
;;;********************************************************************

;;; Исходные факты: 5 сотрудников
(deffacts sotrudniki
   (sotrudnik Ivanov 22 1 50000)   ; стаж >= 5 и > 20 (ветеран труда) -> премия 10000
   (sotrudnik Petrov 3 3 40000)    ; стаж < 5, но детей > 2 -> премия 8000
   (sotrudnik Sidorov 5 0 45000)   ; стаж >= 5 -> премия 9000
   (sotrudnik Smirnov 10 2 60000)  ; стаж >= 5 -> премия 12000
   (sotrudnik Orlov 2 1 35000))    ; стаж < 5 и детей <= 2 -> без премии

;;; Правило 1: начисление премии 20% от оклада (стаж >= 5 или детей > 2)
(defrule nachislit-premiu "Начисление премии 20% от оклада"
   (sotrudnik ?fio ?stazh ?deti ?oklad)
   (test (or (>= ?stazh 5) (> ?deti 2)))
   (not (premia ?fio ?))
   =>
   (bind ?summa (* ?oklad 0.2))
   (assert (premia ?fio ?summa))
   (printout t "Начислена премия сотруднику " ?fio ": " ?summa crlf))

;;; Правило 2а: все сотрудники получили премию (salience -10 — после начисления всех премий)
(defrule all-sotrudniki-premia "Проверка: все ли сотрудники получили премию (да)"
   (declare (salience -10))
   (forall (sotrudnik ?fio ? ? ?)
           (premia ?fio ?))
   =>
   (printout t "Все сотрудники получили премию." crlf))

;;; Правило 2б: не все сотрудники получили премию
(defrule not-all-sotrudniki-premia "Проверка: все ли сотрудники получили премию (нет)"
   (declare (salience -10))
   (exists (sotrudnik ?fio ? ? ?)
           (not (premia ?fio ?)))
   =>
   (printout t "Не все сотрудники получили премию." crlf))

;;; Правило 3а: есть ветераны труда (стаж > 20 лет)
(defrule has-veteran-truda "Проверка наличия ветеранов труда (есть)"
   (declare (salience -10))
   (exists (sotrudnik ? ?stazh ? ?)
           (test (> ?stazh 20)))
   =>
   (printout t "Среди сотрудников есть ветераны труда (стаж более 20 лет)." crlf))

;;; Правило 3б: нет ветеранов труда
(defrule no-veteran-truda "Проверка наличия ветеранов труда (нет)"
   (declare (salience -10))
   (not (exists (sotrudnik ? ?stazh ? ?)
                (test (> ?stazh 20))))
   =>
   (printout t "Среди сотрудников нет ветеранов труда." crlf))

