;;;********************************************************************
;;;  Раздел 5, задание 4. Процедурные функции
;;;
;;;  Условие:
;;;    Создать правило для вычисления суммы:
;;;      S = 1/2^2 + 1/4^2 + 1/6^2 + ... + 1/(2n)^2
;;;
;;;  Запуск в CLIPS:
;;;    (clear)
;;;    (load "clips-labs/lab5_4_summa.clp")
;;;    (reset)
;;;    (run)
;;;********************************************************************

(defrule summa_kvadratov "Вычисление суммы S = 1/2^2 + 1/4^2 + ... + 1/(2n)^2"
   =>
   (printout t "Введите натуральное число n: ")
   (bind ?n (read))
   (while (or (not (integerp ?n)) (< ?n 1)) do
      (printout t "Ошибка: введите целое число n >= 1: ")
      (bind ?n (read)))
   (bind ?sum 0.0)
   (loop-for-count (?i 1 ?n) do
      (bind ?sum (+ ?sum (/ 1 (** (* 2 ?i) 2)))))
   (printout t "S = " ?sum crlf))

