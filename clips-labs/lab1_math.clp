;;;********************************************************************
;;;  Раздел 1. Вычисление математических выражений в режиме командной строки
;;;  Варианты: c, e, h
;;;
;;;  Запуск: clips -f2 clips-labs/lab1_math.clp
;;;     или в CLIPS: (batch "clips-labs/lab1_math.clp")
;;;********************************************************************

;;; c) sqrt(5^4 + sqrt(7^2 + 1) + ln(20.5))
(printout t "c) sqrt(5^4 + sqrt(7^2 + 1) + ln(20.5)) = "
            (sqrt (+ (** 5 4) (sqrt (+ (** 7 2) 1)) (log 20.5))) crlf)

;;; e) max(2^3, 3^2, 2^5)
(printout t "e) max(2^3, 3^2, 2^5) = "
            (max (** 2 3) (** 3 2) (** 2 5)) crlf)

;;; h) 2 * e^4 - 4 - |sin(6^2)|
(printout t "h) 2*e^4 - 4 - |sin(6^2)| = "
            (- (* 2 (exp 4)) 4 (abs (sin (** 6 2)))) crlf)

;;; Прямые выражения (как при вводе в командную строку CLIPS>):
(sqrt (+ (** 5 4) (sqrt (+ (** 7 2) 1)) (log 20.5)))
(max (** 2 3) (** 3 2) (** 2 5))
(- (* 2 (exp 4)) 4 (abs (sin (** 6 2))))
(exit)

