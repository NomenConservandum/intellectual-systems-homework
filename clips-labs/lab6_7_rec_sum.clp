;;;********************************************************************
;;;  Раздел 6, задание 7. Рекурсивные функции пользователя
;;;
;;;  Условие:
;;;    Создать рекурсивную функцию для вычисления суммы вида:
;;;      S = sum_{i=1}^{n} 1 / (2*i + 1)
;;;
;;;  Запуск в CLIPS:
;;;    (clear)
;;;    (load "clips-labs/lab6_7_rec_sum.clp")
;;;    (reset)
;;;    (run)
;;;********************************************************************

;;; Рекурсивная функция вычисления суммы S(n) = sum_{i=1}^{n} 1 / (2*i + 1)
(deffunction rec-sum (?n)
   (if (<= ?n 0)
       then 0
       else (+ (/ 1 (+ (* 2 ?n) 1)) (rec-sum (- ?n 1)))))

(defrule sum_rec_rule "Ввод n и рекурсивное вычисление суммы S"
   =>
   (printout t "Введите натуральное число n: ")
   (bind ?n (read))
   (while (or (not (integerp ?n)) (< ?n 1)) do
      (printout t "Ошибка: введите целое число n >= 1: ")
      (bind ?n (read)))
   (bind ?s (rec-sum ?n))
   (printout t "S(" ?n ") = " ?s crlf))

