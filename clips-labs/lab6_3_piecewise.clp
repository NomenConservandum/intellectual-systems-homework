;;;********************************************************************
;;;  Раздел 6, задание 3. Функции пользователя
;;;
;;;  Условие:
;;;    Определить функцию для вычисления значения Y = f(X) с выбором
;;;    формулы в соответствии с условием:
;;;      Y = 1 - x^2,   если x < c
;;;      Y = 0,         если c <= x < d
;;;      Y = 1 + x^2,   если x >= d
;;;
;;;  Запуск в CLIPS:
;;;    (clear)
;;;    (load "clips-labs/lab6_3_piecewise.clp")
;;;    (reset)
;;;    (run)
;;;********************************************************************

;;; Функция вычисления кусочно-заданной функции Y = f(x, c, d)
(deffunction calc-y (?x ?c ?d)
   (if (< ?x ?c)
       then (- 1 (** ?x 2))
       else (if (< ?x ?d)
                then 0
                else (+ 1 (** ?x 2)))))

(defrule vychislit_y "Ввод x, c, d и вычисление Y = f(x)"
   =>
   (printout t "Введите x: ")
   (bind ?x (read))
   (printout t "Введите c: ")
   (bind ?c (read))
   (printout t "Введите d (d >= c): ")
   (bind ?d (read))
   (while (< ?d ?c) do
      (printout t "Ошибка: должно выполняться d >= c. Введите d: ")
      (bind ?d (read)))
   (bind ?y (calc-y ?x ?c ?d))
   (printout t "Y = " ?y crlf))

